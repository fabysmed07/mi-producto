# Plantilla de variables de entorno de Soltura.
# Copia este archivo a .env.local y pide los valores al dueño del proyecto (de la base de DESARROLLO, nunca la de producción).
# .env.local no se sube a git. No pegues valores reales en este archivo.

# URL del proyecto de Supabase (la usan el navegador de la app y el servidor).
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública de Supabase: con ella y la sesión del usuario se consulta la base aplicando RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta de Supabase: ignora RLS. Solo servidor: panel admin y formularios públicos (signups y feedback). Nunca en código de navegador.
SUPABASE_SECRET_KEY=

# Emails con acceso a /admin, separados por coma. Si queda vacía, nadie es admin.
ADMIN_EMAILS=

# Solo en deploy (Vercel), no hace falta en local: conexión directa a la base para aplicar migraciones en producción.
# Vercel la define; si la usas aquí, déjala comentada. VERCEL_ENV también la pone Vercel.
# POSTGRES_URL_NON_POOLING=
